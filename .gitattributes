*.skel.bytes            lfs

# Opaque data blobs. A file that is read as bytes has nothing to diff and changes wholesale on
# every save, which is the whole case for LFS. Databases are here for the same reason.
*.bin                   lfs
*.blob                  lfs
*.bytes                 lfs
*.dat                   lfs
*.db                    lfs
*.pak                   lfs
*.sqlite                lfs
*.sqlite3               lfs

# An OpenPGP message. Ciphertext is incompressible and differs in every byte from the previous
# version even when the plaintext barely moved - the worst possible thing to keep as a plain
# object.
*.gpg                   lfs

# Exceptions for .asset files (mostly scene generated files). These are binary YAML or plain
# binary payloads: merging them as text produces a file Unity cannot load.
LightingData.asset      binary
*.terrain.asset         binary
*_comp_dir.png          binary
*_comp_light.exr        binary
