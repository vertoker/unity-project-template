# Universal .gitignore for a Unity project.
#
# Base is the official template - https://github.com/github/gitignore/blob/main/Unity.gitignore -
# with the additions that proved themselves across the projects in this workspace. Everything here
# is project-agnostic on purpose: a rule that names one game's own folder belongs in that game's
# repository, not in the template.

# --------------------------------------------------------------------------------------------
# Unity generated folders
# --------------------------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
.utmp/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data.
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Profiler and coverage output - regenerated on every run, never reviewed as a diff
/[Pp]rofilerCaptures/
/[Cc]odeCoverage/

# Screenshots taken from the editor or a build: throwaway captures, and a source of accidental
# multi-megabyte commits
/[Ss]creenshots/

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Crashlytics generated file
crashlytics-build.properties

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be
# commited to version control.
*.blend1
*.blend1.meta

# --------------------------------------------------------------------------------------------
# Unity generated project files
# --------------------------------------------------------------------------------------------

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# TestRunner generated files
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# --------------------------------------------------------------------------------------------
# Unity packages that generate content
# --------------------------------------------------------------------------------------------

# Addressables default ignores, before user customizations
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Performance Testing extension writes its run info into Resources
/[Aa]ssets/Resources/PerformanceTestRunInfo.json
/[Aa]ssets/Resources/PerformanceTestRunInfo.json.meta
/[Aa]ssets/Resources/PerformanceTestRunSettings.json
/[Aa]ssets/Resources/PerformanceTestRunSettings.json.meta

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# NuGetForUnity - restored packages, reproducible from the manifest
/[Aa]ssets/[Pp]ackages/
/[Aa]ssets/[Pp]ackages.meta
/[Nn]u[Gg]et/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# --------------------------------------------------------------------------------------------
# IDEs
# --------------------------------------------------------------------------------------------

# JetBrains Rider: the .idea folder and the .run configurations are COMMITTED on purpose - shared
# code style, dictionaries, encodings and run configurations are project decisions, not personal
# ones. Rider writes its own .idea/.idea.<Project>/.idea/.gitignore for the volatile files; these
# rules repeat it without naming the project, so a rename does not start committing editor state.
.idea/**/workspace.xml
.idea/**/shelf/
.idea/**/httpRequests/
.idea/**/contentModel.xml
.idea/**/modules.xml
.idea/**/projectSettingsUpdater.xml
.idea/**/dataSources/
.idea/**/dataSources.local.xml
.idea/**/*.iml
riderModule.iml
/_ReSharper.Caches/

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/
# File .vsconfig is a part of Visual Studio 2022 Installer that able to exists in Unity's project
# folder.
.vsconfig

# Visual Studio Code
.vscode/

# Personal overrides of agent instructions - the shared CLAUDE.md is committed, this one is not
CLAUDE.local.md

# --------------------------------------------------------------------------------------------
# Build output
# --------------------------------------------------------------------------------------------
.gradle/
*.apk
*.aab
*.app
*.ipa
*.unitypackage
*.unitypackage.meta

# --------------------------------------------------------------------------------------------
# Non-Unity subprojects living in the same repository (tools, exporters, servers, sync scripts)
# --------------------------------------------------------------------------------------------

# .NET. These match at any depth, Assets/ included - Unity itself never produces such a folder
# there, but a vendored plugin that ships one needs an explicit negation next to it.
[Bb]in/
[Oo]bj/
/packages/

# Python
.venv/
__pycache__/
*.py[co]

# Secrets. Nothing here is recoverable once pushed, so the patterns are deliberately wide and an
# example file is the only thing let through.
/[Ss]ecrets/
.env
.env.*
*.env
!.env.example
*.token.json

# --------------------------------------------------------------------------------------------
# OS junk
# --------------------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
